      "originalText": "enum ConsumerType {\n    PREMIUM, NORMAL\n}\n\nclass CouponAdmin {\n    String id;\n    String name;\n    CouponManager couponManager;\n}\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "BUDRtSTHpWtpoepagySa8",

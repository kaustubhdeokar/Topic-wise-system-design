      "seed": 697891952,
      "version": 1616,
      "versionNonce": 1234990165,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1736874507376,
      "link": null,
      "locked": false,
      "text": "class Product {\n    String productId;\n    String productName;\n    ProductType type;\n    Double price;\n}\n\nenum ProductType {\n    CLOTHING, GROCERY, ELECTRONICS...\n}\n\nclass Cart {\n    String cartId;\n    Map<String, Integer> productQuantityMap;\n    Double cartAmount;\n    String userId; \n\n    List<Coupon> recommendCoupons() {\n        return coupons;\n    }\n}\n\nclass Coupon {\n    String couponId;\n    String description;\n    CouponType couponType; // FLAT CHARGE DEDUCT, PERCENTAGE DEDUCTION\n    DateTime expiry;\n    List<Rule> rules;\n    boolean isActive;\n    boolean isValid() {\n        for(List rule: rules) {\n            rule.isRuleApplicable();\n        }\n    }\n}\n\ninterface Rule {\n       boolean isRuleApplicable(Order order);\n}\n\n// strategy pattern\nclass ProductRule implements Rule {\n}\n\nclass PriceRule implements Rule {\n}\n\nclass Order {\n    String orderId;\n    String userId;\n    Double amount;\n    \n}\n\nclass CouponUserManager {\n    Map<String, Map<String, User>> couponUsedByUsersMap;\n    Map<String, Map<String, Coupon>> usersCouponUsedMap;\n}\n\nclass CouponManager {\n    Map<String, Coupon> coupons;\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Product {\n    String productId;\n    String productName;\n    ProductType type;\n    Double price;\n}\n\nenum ProductType {\n    CLOTHING, GROCERY, ELECTRONICS...\n}\n\nclass Cart {\n    String cartId;\n    Map<String, Integer> productQuantityMap;\n    Double cartAmount;\n    String userId; \n\n    List<Coupon> recommendCoupons() {\n        return coupons;\n    }\n}\n\nclass Coupon {\n    String couponId;\n    String description;\n    CouponType couponType; // FLAT CHARGE DEDUCT, PERCENTAGE DEDUCTION\n    DateTime expiry;\n    List<Rule> rules;\n    boolean isActive;\n    boolean isValid() {\n        for(List rule: rules) {\n            rule.isRuleApplicable();\n        }\n    }\n}\n\ninterface Rule {\n       boolean isRuleApplicable(Order order);\n}\n\n// strategy pattern\nclass ProductRule implements Rule {\n}\n\nclass PriceRule implements Rule {\n}\n\nclass Order {\n    String orderId;\n    String userId;\n    Double amount;\n    \n}\n\nclass CouponUserManager {\n    Map<String, Map<String, User>> couponUsedByUsersMap;\n    Map<String, Map<String, Coupon>> usersCouponUsedMap;\n}\n\nclass CouponManager {\n    Map<String, Coupon> coupons;\n}",
      "autoResize": true,
      "lineHeight": 1.25
    }

      "updated": 1736874152898,
      "link": null,
      "locked": false,
      "text": "enum ConsumerType {\n    PREMIUM, NORMAL\n}\n\nclass CouponAdmin {\n    String id;\n    String name;\n    CouponManager couponManager;\n}\n\n",
      "fontSize": 20,
      "fontFamily": 8,
